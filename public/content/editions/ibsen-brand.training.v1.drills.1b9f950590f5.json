      "text": "skjæres",
      "wordCount": 1
    },
    {
      "id": "w-06",
      "order": 48,
      "kind": "word",
      "text": "blålysblink",
      "wordCount": 1
    },
    {
      "id": "w-07",
      "order": 49,
